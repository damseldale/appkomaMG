# ==========================================
# GLOBAL & API GATEWAY CONFIGURATION
# ==========================================
PORT=4000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_ganti_dengan_yang_aman

# ==========================================
# FRONTEND CLIENT CONFIGURATION (Vite)
# ==========================================
# Gunakan prefiks VITE_ agar terbaca oleh aplikasi frontend
VITE_API_URL=http://localhost:4000

# ==========================================
# MICROSERVICES PORTS & HOSTS
# ==========================================
SERVICE_USERS_PORT=4001
SERVICE_PROJECTS_PORT=4002
SERVICE_ASSETS_PORT=4003
SERVICE_TTS_PORT=4004
SERVICE_RENDER_PORT=4005

# ==========================================
# DATABASE & REDIS CONFIGURATION
# ==========================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/animaker_db
MONGO_URI=mongodb://localhost:27017/animaker_projects
REDIS_HOST=localhost
REDIS_PORT=6379

# ==========================================
# THIRD-PARTY INTEGRATIONS (Stripe & AWS)
# ==========================================
# Stripe Billing
STRIPE_SECRET_KEY=sk_test_mock_key_ganti_dengan_asli
STRIPE_WEBHOOK_SECRET=whsec_mock_secret_ganti_dengan_asli
CLIENT_URL=http://localhost:5173

# AWS S3 Storage (Asset Uploader & Render Engine)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=animaker-production-assets
